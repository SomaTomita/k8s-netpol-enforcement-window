# Go
/bin/
*.test
*.out

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# kind / kubeconfig
kubeconfig-*
*.kubeconfig

# measurement data — raw is checked separately via checksums, not committed.
# Directories must be un-ignored explicitly (git never descends into an
# already-excluded directory to test file-level negations below), so this
# supports checksums nested arbitrarily deep, e.g. data/raw/<run-id>/*.sha256.
data/raw/**
data/interim/**
data/processed/**
!data/raw/**/
!data/interim/**/
!data/processed/**/
!data/**/.gitkeep
!data/**/*.sha256

# ...except developer scratch, which is a record of nothing: scripts/
# collect.sh and the trial-script smoke runs write throwaway trials into
# data/raw/dev/, and the negation above would otherwise make each one's
# checksums.sha256 committable. A later pattern wins, so this re-ignores
# the whole directory.
data/raw/dev/

# ...but the one instrument-check trial the Experiment 1b pre-registration
# cites for its H2 threshold must stay auditable, on the same rule as every
# other trial: its checksum is committed, its stream is not. git prunes an
# excluded directory from traversal entirely, so re-including a file two
# levels down means re-opening (and re-closing) every level in between —
# see gitignore(5), "It is not possible to re-include a file if a parent
# directory of that file is excluded".
!data/raw/dev/
data/raw/dev/*
!data/raw/dev/smoke-with-victim/
data/raw/dev/smoke-with-victim/*
!data/raw/dev/smoke-with-victim/checksums.sha256

# editor / OS
.DS_Store
.idea/
.vscode/

# local agent tooling (not part of the research artifact)
.claude/
.agents/
skills-lock.json

